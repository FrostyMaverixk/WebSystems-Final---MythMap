# Mapbox GL JS (public pk.* token)
VITE_MAPBOX_TOKEN=pk.your_public_mapbox_token_here
# Leave blank to use the bundled archival parchment atlas style
VITE_MAPBOX_STYLE=

# Firebase Web App Config (Free Spark Plan: Hosting, Auth, Cloud Firestore)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: set to true when testing against `firebase emulators:start`
VITE_USE_FIREBASE_EMULATORS=false

# Optional: Cloudinary Unsigned Upload for user-submitted myth images
# Leave blank to gracefully disable image upload controls without errors
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
